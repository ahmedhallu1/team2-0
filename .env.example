# ─────────────────────────────────────────────────────────────
#  2.0 — environment template. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────

# ── Contact form: mail transport ─────────────────────────────
# Preferred. Brevo → SMTP & API → API Keys. Free tier: 300 emails/day.
# Authenticate elevate2point0.com in Brevo first so mail is DKIM-signed
# as the domain. See docs/EMAIL-SETUP.md.
BREVO_API_KEY=

# The address Brevo sends as. Must be on a domain authenticated in Brevo.
BREVO_SENDER=contact@elevate2point0.com

# Fallback transport — only used when BREVO_API_KEY is empty.
# Gmail OAuth2 (Google "Web" OAuth client credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Mint with: node scripts/get-gmail-refresh-token.mjs
GMAIL_REFRESH_TOKEN=

# The Gmail address you authorize with (sends the mail)
GMAIL_SENDER=

# ── Addresses ────────────────────────────────────────────────
# Where inquiries are delivered
CONTACT_TO=contact@elevate2point0.com

# The address we present as ours in replies (defaults to contact@elevate2point0.com)
CONTACT_FROM=contact@elevate2point0.com

# Optional: public mailto link shown in the site
NEXT_PUBLIC_CONTACT_EMAIL=contact@elevate2point0.com

# Production URL for SEO/social metadata (defaults to https://elevate2point0.com)
NEXT_PUBLIC_SITE_URL=https://elevate2point0.com

# ── WhatsApp Business Platform (Meta Cloud API) ──────────────
# Setup walkthrough: docs/WHATSAPP-SETUP.md

# Meta app → App settings → Basic → App secret. Used to verify that webhook
# deliveries really come from Meta. The webhook rejects everything if unset.
META_APP_SECRET=

# Any long random string you choose. Paste the same value into the dashboard's
# WhatsApp → Configuration → Webhook → Verify token field.
WHATSAPP_VERIFY_TOKEN=

# The number messages are sent from (WhatsApp → API Setup → Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=

# System-user token with whatsapp_business_messaging. The temporary token on
# the API Setup page expires in ~24h — use a permanent one in production.
WHATSAPP_ACCESS_TOKEN=

# Optional. Bearer secret for POST /api/whatsapp/send. Unset = endpoint closed.
WHATSAPP_SEND_SECRET=

# Optional. If set, customers get this text as an automatic reply (max once per
# 6h per customer). Leave empty for no auto-reply.
WHATSAPP_AUTO_REPLY=

# Optional. Defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
