# ─────────────────────────────────────────────────────────────
#  2.0 — environment template. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────

# Gmail OAuth2 for the contact form (Google "Web" OAuth client credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Mint with: node scripts/get-gmail-refresh-token.mjs
GMAIL_REFRESH_TOKEN=

# The Gmail address you authorize with (sends the mail)
GMAIL_SENDER=

# Where inquiries are delivered (defaults to info@elevate2point0.com if blank)
CONTACT_TO=info@elevate2point0.com

# Optional: public mailto link shown in the site (defaults to info@elevate2point0.com)
NEXT_PUBLIC_CONTACT_EMAIL=info@elevate2point0.com

# Production URL for SEO/social metadata (defaults to https://elevate2point0.com)
NEXT_PUBLIC_SITE_URL=https://elevate2point0.com
