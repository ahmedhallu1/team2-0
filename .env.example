# ─────────────────────────────────────────────────────────────
#  2.0 — environment template. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────

# Gmail OAuth2 for the contact form (Google "Web" OAuth client credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Mint with: node scripts/get-gmail-refresh-token.mjs
GMAIL_REFRESH_TOKEN=

# The Gmail address you authorize with (sends the mail)
GMAIL_SENDER=

# Where inquiries are delivered (defaults to GMAIL_SENDER if blank)
CONTACT_TO=

# Optional: public mailto link shown in the contact section
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: production URL for SEO/social metadata, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
